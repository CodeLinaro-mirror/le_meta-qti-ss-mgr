#!/bin/sh /etc/rc.common

# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
# SPDX-License-Identifier: BSD-3-Clause-Clear

if [ -e "/etc/data/mbim_early_init" ]; then
    START=04
    STOP=95
else
    START=15
    STOP=84
fi

start() {
    [ -e "/sys/kernel/qcom_rproc/dump_level" ] && [ -s "/etc/dump_level" ] && cat "/etc/dump_level" > /sys/kernel/qcom_rproc/dump_level
    echo "Updating remoteproc0 state to start." >> /dev/kmsg
    echo "Starting Modem and CDSP service"
    echo start > /sys/class/remoteproc/remoteproc0/state
    echo start > /sys/class/remoteproc/remoteproc1/state

}

stop() {
    echo "Stopping Modem and CDSP service"
    echo stop > /sys/class/remoteproc/remoteproc0/state
    echo stop > /sys/class/remoteproc/remoteproc1/state
}
