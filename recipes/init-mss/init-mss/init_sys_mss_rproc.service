[Unit]
Description=Service to trigger modem load based on remoteproc
After=firmware-mount.service
Requires=firmware-mount.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart= /bin/sh -c ' for d in /sys/class/remoteproc/remoteproc*/; do if [ \"$(cat \"$d/name\")\" ==  \"4080000.remoteproc-mss\" ]; then echo start > $d/state; fi; done '

[Install]
WantedBy=multi-user.target
