[Unit]
Description=Service to trigger modem load based on remoteproc
After=firmware-mount.service
Requires=firmware-mount.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo start > /sys/class/remoteproc/remoteproc0/state'
ExecStop=/bin/sh -c 'echo stop > /sys/class/remoteproc/remoteproc0/state'

[Install]
WantedBy=multi-user.target
