[Unit]
Description=Monitor qcom_rproc dump_level sysfs node for changes
ConditionPathExists=/sys/kernel/qcom_rproc/dump_level

[Path]
PathChanged=/sys/kernel/qcom_rproc/dump_level
Unit=dump-level-monitor.service

[Install]
WantedBy=sysinit.target
