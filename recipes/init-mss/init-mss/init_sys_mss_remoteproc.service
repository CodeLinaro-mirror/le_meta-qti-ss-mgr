[Unit]
Description=Modem Init Service
After=firmware.mount
BindsTo=rmt_storage.service
Requires=firmware.mount

[Service]
Restart=on-failure
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo "start" > /sys/class/remoteproc/remoteproc0/state'
Nice=-5

[Install]
WantedBy=sysinit.target
